# Copy to .env.local for local development. Set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Required: lets the contact form send email through Resend (https://resend.com/api-keys).
RESEND_API_KEY=

# Optional: sender address. Only works after pawanjoshi.dev is verified in Resend → Domains.
# Defaults to Resend's test sender, which only delivers to your Resend account email.
CONTACT_FROM="Pawan Joshi <contact@pawanjoshi.dev>"

# Optional: where contact messages are delivered. Defaults to me@pawanjoshi.dev.
CONTACT_TO=me@pawanjoshi.dev

# Optional: Google Search Console → Add property → URL prefix → HTML tag. Paste only the content="..." value.
GOOGLE_SITE_VERIFICATION=

# Optional: Bing Webmaster Tools → Add site → HTML meta tag. Paste only the content="..." value.
BING_SITE_VERIFICATION=
